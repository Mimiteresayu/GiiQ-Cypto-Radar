# C48-2 Hummingbot — placeholders only. Real values go in Railway service Variables (MMT).
# Never commit a filled copy (.env is gitignored).

# Password Hummingbot uses to encrypt conf/connectors/*.yml (any strong random string).
CONFIG_PASSWORD=change-me
# HL testnet MAIN account address (0x...) that the API wallet trades for.
HL_TESTNET_ADDRESS=0x0000000000000000000000000000000000000000
# Private key of an HL testnet API wallet (https://app.hyperliquid-testnet.xyz/API). API wallets cannot withdraw.
HL_TESTNET_API_WALLET_KEY=0xYOUR_TESTNET_API_WALLET_PRIVATE_KEY
# Testnet account equity in USD; used for the NAV 2% target / 8% cap check.
GIIQ_NAV_USD=2500
# Optional: base-size override, = (NAV * 0.02) / mid. Guard refuses if notional > NAV 8%.
GIIQ_ORDER_AMOUNT=
# Optional: mid price for the sizing check; default is live BTC mid from HL testnet allMids.
GIIQ_MID_PRICE=
