{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops_cron/Dockerfile",
    "watchPatterns": ["ops_cron/**"]
  },
  "deploy": {
    "startCommand": "python -m ops_cron exit-monitor",
    "cronSchedule": "12 * * * *",
    "restartPolicyType": "NEVER"
  }
}
