{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops_cron/Dockerfile",
    "watchPatterns": ["ops_cron/**"]
  },
  "deploy": {
    "startCommand": "python -m ops_cron.main bo-report",
    "cronSchedule": "32 1,12 * * 1-5",
    "restartPolicyType": "NEVER"
  }
}
