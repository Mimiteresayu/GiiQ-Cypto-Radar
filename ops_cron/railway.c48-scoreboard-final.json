{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ops_cron/Dockerfile",
    "watchPatterns": ["ops_cron/**"]
  },
  "deploy": {
    "startCommand": "python -m ops_cron.main c48-scoreboard",
    "cronSchedule": "40 12 7 10 *",
    "restartPolicyType": "NEVER"
  }
}
